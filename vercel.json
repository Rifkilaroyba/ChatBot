{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "data/products.csv,knowledge.json,lib/**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}

